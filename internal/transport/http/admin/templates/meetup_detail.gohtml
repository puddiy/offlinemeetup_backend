{{define "meetup_detail"}}{{template "layout" .}}{{end}}
{{define "content"}}
{{$d := .Data}}
{{$m := $d.Meetup}}
<a class="back" href="/admin/meetups">← Митапы</a>
<div class="page-header">
    <div>
        <h1>{{$m.Title}}</h1>
        <p class="subtitle">
            {{badge "meetup_status" $m.Status}}
            {{if $m.IsOfficial}}{{mark "accent" "официальный"}}{{end}}
            {{if $m.IsPublic}}{{mark "neutral" "публичный"}}{{else}}{{mark "neutral" "приватный"}}{{end}}
        </p>
    </div>
    {{if $d.CanEdit}}<a class="btn btn-secondary" href="/admin/meetups/{{$m.ID}}/edit">Редактировать</a>{{end}}
</div>

<div class="card">
    {{if $m.CoverURL}}<img class="cover" src="{{$m.CoverURL}}" alt="Обложка митапа">{{end}}

    <table class="kv">
        <tr><th>ID</th><td>{{$m.ID}}</td></tr>
        <tr><th>Начало</th><td>{{dt $m.StartTime}}</td></tr>
        <tr><th>Окончание</th><td>{{dt $m.EndTime}}</td></tr>
        <tr><th>Адрес</th><td>{{$m.Address}} <span class="muted small">{{$m.Lat}}, {{$m.Lng}}</span></td></tr>
        <tr><th>Создатель</th><td><a href="/admin/users/{{$m.CreatorID}}">{{$m.CreatorName}}</a></td></tr>
        <tr><th>Участников</th><td>{{$m.ParticipantsCount}}</td></tr>
        <tr><th>Теги</th><td>{{range $m.Tags}}{{mark "neutral" .}} {{else}}<span class="muted">нет</span>{{end}}</td></tr>
        {{if $m.InviteToken}}<tr><th>Инвайт-токен</th><td><code>{{$m.InviteToken}}</code></td></tr>{{end}}
    </table>

    {{if $m.Description}}<div class="description">{{$m.Description}}</div>{{end}}

    {{if eq $m.Status "active"}}
    <div class="actions">
        <span class="spacer"></span>
        <form method="post" action="/admin/meetups/{{$m.ID}}/cancel" class="inline"
              onsubmit="return confirm('Отменить митап? Чат станет только для чтения, открытые жалобы на митап закроются. Действие необратимо.')">
            <button type="submit" class="btn-danger">Отменить митап</button>
        </form>
    </div>
    {{end}}
</div>
{{end}}
