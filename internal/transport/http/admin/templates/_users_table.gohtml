{{define "users_table"}}
<table class="table">
    <thead>
    <tr>
        <th class="num">ID</th><th>Email</th><th>Username</th><th>Имя</th><th>Статус</th><th>Создан</th>
    </tr>
    </thead>
    <tbody>
    {{range .Page.Items}}
    <tr>
        <td class="num"><a href="/admin/users/{{.ID}}">{{.ID}}</a></td>
        <td>{{if .Email}}{{.Email}}{{else}}<span class="muted">—</span>{{end}}</td>
        <td>{{.Username}}</td>
        <td>{{.DisplayName}} {{if .IsSystem}}{{mark "accent" "служебный"}}{{end}}</td>
        <td>{{if .IsDeleted}}{{mark "danger" "удалён"}}{{else}}{{badge "user_status" .Status}}{{end}}</td>
        <td class="nowrap">{{date .CreatedAt}}</td>
    </tr>
    {{else}}
    <tr><td colspan="6" class="empty">Ничего не найдено</td></tr>
    {{end}}
    </tbody>
</table>

<div class="pager">
    <span>Всего: {{.Page.Total}}{{if .Page.Pages}} · страница {{.Page.CurrentPage}} из {{.Page.Pages}}{{end}}</span>
    <span class="links">
        {{if .Page.HasPrev}}<a class="btn btn-secondary btn-sm" href="{{.LinkWithOffset .Page.PrevOffset}}">← Назад</a>{{end}}
        {{if .Page.HasNext}}<a class="btn btn-secondary btn-sm" href="{{.LinkWithOffset .Page.NextOffset}}">Вперёд →</a>{{end}}
    </span>
</div>
{{end}}
