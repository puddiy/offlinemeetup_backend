{{define "meetups"}}{{template "layout" .}}{{end}}
{{define "content"}}
{{$d := .Data}}
<div class="page-header">
    <h1>Митапы</h1>
    {{if $d.CanPublish}}<a class="btn" href="/admin/meetups/new">+ Официальный митап</a>{{end}}
</div>

<form method="get" action="/admin/meetups" class="card filters">
    <label class="field grow">
        <span>Поиск</span>
        <input type="text" name="q" value="{{$d.Search}}" placeholder="название или id">
    </label>
    <label class="field">
        <span>Статус</span>
        <select name="status">
            <option value="">все</option>
            <option value="active"{{if eq $d.Status "active"}} selected{{end}}>активные</option>
            <option value="past"{{if eq $d.Status "past"}} selected{{end}}>прошедшие</option>
            <option value="cancelled"{{if eq $d.Status "cancelled"}} selected{{end}}>отменённые</option>
        </select>
    </label>
    <label class="check">
        <input type="checkbox" name="official" value="1"{{if $d.OnlyOfficial}} checked{{end}}>
        только официальные
    </label>
    <button type="submit">Искать</button>
</form>

<div class="card card-flush">
    <table class="table">
        <thead>
        <tr>
            <th class="num">ID</th><th>Название</th><th>Статус</th><th>Начало</th><th>Создатель</th><th class="num">Участников</th>
        </tr>
        </thead>
        <tbody>
        {{range $d.Page.Items}}
        <tr>
            <td class="num">{{.ID}}</td>
            <td><a href="/admin/meetups/{{.ID}}">{{.Title}}</a> {{if .IsOfficial}}{{mark "accent" "официальный"}}{{end}}</td>
            <td>{{badge "meetup_status" .Status}}</td>
            <td class="nowrap">{{dt .StartTime}}</td>
            <td>{{.CreatorName}}</td>
            <td class="num">{{.ParticipantsCount}}</td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="empty">Ничего не найдено</td></tr>
        {{end}}
        </tbody>
    </table>
    <div class="pager">
        <span>Всего: {{$d.Page.Total}}{{if $d.Page.Pages}} · страница {{$d.Page.CurrentPage}} из {{$d.Page.Pages}}{{end}}</span>
        <span class="links">
            {{if $d.Page.HasPrev}}<a class="btn btn-secondary btn-sm" href="{{$d.LinkWithOffset $d.Page.PrevOffset}}">← Назад</a>{{end}}
            {{if $d.Page.HasNext}}<a class="btn btn-secondary btn-sm" href="{{$d.LinkWithOffset $d.Page.NextOffset}}">Вперёд →</a>{{end}}
        </span>
    </div>
</div>
{{end}}
