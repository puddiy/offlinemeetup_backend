{{define "user_detail"}}{{template "layout" .}}{{end}}
{{define "content"}}
{{$u := .Data.User}}
<a class="back" href="/admin/users">← Пользователи</a>
<div class="page-header">
    <div>
        <h1>{{.Data.DisplayName}}</h1>
        <p class="subtitle">
            {{if .Data.IsDeleted}}{{mark "danger" "удалён"}}{{else}}{{badge "user_status" $u.Status}}{{end}}
            {{if .Data.IsSystem}}{{mark "accent" "служебный"}}{{end}}
        </p>
    </div>
</div>

<div class="card">
    {{if .Data.IsSystem}}
    <div class="note">Служебный аккаунт: создатель официальных митапов. Войти под ним нельзя, блокировка и удаление запрещены.</div>
    {{end}}

    <table class="kv">
        <tr><th>ID</th><td>{{$u.ID}}</td></tr>
        <tr><th>Email</th><td>{{if $u.Email}}{{$u.Email}}{{else if .Data.IsSystem}}<span class="muted">нет — у служебного аккаунта email не бывает</span>{{else}}<span class="muted">обнулён при удалении</span>{{end}}</td></tr>
        <tr><th>Username</th><td>{{.Data.Username}}</td></tr>
        <tr><th>Зарегистрирован</th><td>{{dt $u.CreatedAt}}</td></tr>
        {{if $u.DeletedAt}}<tr><th>Удалён</th><td>{{dt $u.DeletedAt}}</td></tr>{{end}}
        <tr><th>Соцаккаунты</th><td>
            {{if $u.Socials}}{{range $u.Socials}}{{mark "neutral" .Provider}} {{end}}{{else}}<span class="muted">нет</span>{{end}}
        </td></tr>
    </table>

    {{if and (not .Data.IsDeleted) (not .Data.IsSystem)}}
    <div class="actions">
        {{if eq (printf "%s" $u.Status) "banned"}}
        <form method="post" action="/admin/users/{{$u.ID}}/unban" class="inline">
            <button type="submit">Разблокировать</button>
        </form>
        {{else}}
        <form method="post" action="/admin/users/{{$u.ID}}/ban" class="inline"
              onsubmit="return confirm('Заблокировать пользователя? Все его будущие и идущие митапы будут отменены, разблокировка их не вернёт.')">
            <button type="submit" class="btn-danger">Заблокировать</button>
        </form>
        {{end}}

        <form method="post" action="/admin/users/{{$u.ID}}/logout-all" class="inline">
            <button type="submit" class="btn-secondary">Отозвать все сессии</button>
        </form>

        {{/* Удаление необратимо и закрыто ролью admin — см. routes.go.
             Здесь кнопка лишь прячется от модератора, чтобы не предлагать
             действие, которое всё равно вернёт 403; сама защита в маршруте. */}}
        {{if and .Admin (eq (printf "%s" .Admin.Role) "admin")}}
        <span class="spacer"></span>
        <form method="post" action="/admin/users/{{$u.ID}}/delete" class="inline"
              onsubmit="return confirm('Удалить аккаунт? Email обнулится, соцпривязки и пароль будут удалены. Действие необратимо.')">
            <button type="submit" class="btn-ghost-danger">Удалить аккаунт</button>
        </form>
        {{end}}
    </div>
    {{end}}
</div>
{{end}}
