{{define "layout"}}<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{{.Title}} — Meetuper Admin</title>
    <link rel="stylesheet" href="/admin/static/admin.css">
    <script src="/admin/static/htmx.min.js" defer></script>
</head>
<body>
{{if .Admin}}
<header class="topbar">
    <a class="brand" href="/admin/">Meetuper <span>admin</span></a>
    <nav class="nav" aria-label="Разделы">
        <a href="/admin/"{{if eq .Section "dashboard"}} class="active" aria-current="page"{{end}}>Дашборд</a>
        <a href="/admin/users"{{if eq .Section "users"}} class="active" aria-current="page"{{end}}>Пользователи</a>
        <a href="/admin/reports"{{if eq .Section "reports"}} class="active" aria-current="page"{{end}}>Жалобы</a>
        <a href="/admin/meetups"{{if eq .Section "meetups"}} class="active" aria-current="page"{{end}}>Митапы</a>
        {{if eq (printf "%s" .Admin.Role) "admin"}}<a href="/admin/tags"{{if eq .Section "tags"}} class="active" aria-current="page"{{end}}>Теги</a>{{end}}
    </nav>
    <div class="who">
        <span>{{.Admin.Email}}</span>
        {{badge "admin_role" .Admin.Role}}
        <form method="post" action="/admin/logout" class="inline">
            <button type="submit" class="btn-ghost btn-sm">Выйти</button>
        </form>
    </div>
</header>
{{end}}
<main class="container">
    {{if .Error}}<div class="error" role="alert">{{.Error}}</div>{{end}}
    {{if .Flash}}<div class="flash" role="status">{{.Flash}}</div>{{end}}
    {{block "content" .}}{{end}}
</main>
</body>
</html>{{end}}
