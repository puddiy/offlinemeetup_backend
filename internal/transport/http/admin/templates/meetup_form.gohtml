{{define "meetup_form"}}{{template "layout" .}}{{end}}
{{define "content"}}
{{$d := .Data}}
<a class="back" href="/admin/meetups">← Митапы</a>
<div class="page-header">
    <div>
        <h1>{{if $d.MeetupID}}Редактирование митапа{{else}}Новый официальный митап{{end}}</h1>
        <p class="subtitle">Публикуется от служебного аккаунта «Meetuper». Время указывается в поясе {{$d.Timezone}}.</p>
    </div>
</div>

<form method="post" action="{{$d.Action}}" class="card form-narrow">
    {{with index $d.Errors "form"}}<div class="error">{{.}}</div>{{end}}

    <label class="field">
        <span>Название</span>
        <input type="text" name="title" value="{{$d.Values.Title}}" required minlength="3" maxlength="200">
        {{with index $d.Errors "title"}}<div class="field-error">{{.}}</div>{{end}}
    </label>

    <label class="field">
        <span>Описание</span>
        <textarea name="description" rows="6" maxlength="5000">{{$d.Values.Description}}</textarea>
        {{with index $d.Errors "description"}}<div class="field-error">{{.}}</div>{{end}}
    </label>

    <div class="form-row">
        <label class="field">
            <span>Начало</span>
            <input type="datetime-local" name="start_time" value="{{$d.Values.Start}}" required>
            {{with index $d.Errors "start_time"}}<div class="field-error">{{.}}</div>{{end}}
        </label>
        <label class="field">
            <span>Окончание</span>
            <input type="datetime-local" name="end_time" value="{{$d.Values.End}}" required>
            {{with index $d.Errors "end_time"}}<div class="field-error">{{.}}</div>{{end}}
        </label>
    </div>

    <div id="address-fields">{{template "address_fields" $d.Values}}</div>
    {{with index $d.Errors "address"}}<div class="field-error">{{.}}</div>{{end}}
    {{with index $d.Errors "coordinates"}}<div class="field-error">{{.}}</div>{{end}}
    {{with index $d.Errors "lat"}}<div class="field-error">{{.}}</div>{{end}}
    {{with index $d.Errors "lng"}}<div class="field-error">{{.}}</div>{{end}}
    <button type="button" class="btn-secondary btn-sm" hx-get="/admin/geo/suggest" hx-include="[name='address']"
            hx-target="#address-suggestions">Найти адрес</button>
    <div id="address-suggestions" class="suggestions"></div>

    <div class="field">
        <label class="check">
            <input type="checkbox" name="is_public" value="1"{{if $d.Values.IsPublic}} checked{{end}}>
            Публичный — виден в ленте
        </label>
    </div>

    <fieldset>
        <legend>Теги</legend>
        <div class="check-list">
            {{range $d.Tags}}
            <label class="check">
                <input type="checkbox" name="tags" value="{{.ID}}"{{if .Checked}} checked{{end}}>
                {{.Name}}{{if .Hidden}} (скрыт){{end}}
            </label>
            {{else}}
            <span class="muted">Теги не загрузились</span>
            {{end}}
        </div>
    </fieldset>

    <div class="actions">
        <button type="submit">{{if $d.MeetupID}}Сохранить{{else}}Опубликовать{{end}}</button>
        <a class="btn btn-ghost" href="/admin/meetups">Отмена</a>
    </div>
</form>
{{end}}
