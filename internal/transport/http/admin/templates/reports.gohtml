{{define "reports"}}{{template "layout" .}}{{end}}
{{define "content"}}
<div class="page-header">
    <h1>Жалобы</h1>
</div>

<form method="get" action="/admin/reports" class="card filters">
    <label class="field">
        <span>Статус</span>
        <select name="status">
            <option value="open"{{if eq .Data.Status "open"}} selected{{end}}>открытые</option>
            <option value="resolved"{{if eq .Data.Status "resolved"}} selected{{end}}>решённые</option>
            <option value="dismissed"{{if eq .Data.Status "dismissed"}} selected{{end}}>отклонённые</option>
            <option value="all"{{if eq .Data.Status "all"}} selected{{end}}>все</option>
        </select>
    </label>
    <label class="field">
        <span>Тип</span>
        <select name="type">
            <option value="">любой</option>
            <option value="meetup"{{if eq .Data.TargetType "meetup"}} selected{{end}}>митап</option>
            <option value="message"{{if eq .Data.TargetType "message"}} selected{{end}}>сообщение</option>
            <option value="user"{{if eq .Data.TargetType "user"}} selected{{end}}>пользователь</option>
        </select>
    </label>
    <button type="submit">Показать</button>
</form>

{{with .Data}}
<div class="card card-flush">
    {{if .Page.Items}}
    <table class="table">
        <thead>
        <tr>
            <th>Жалоба</th><th>Создана</th><th>Цель</th><th>Причина</th><th>Автор контента</th><th>Пожаловался</th><th>Статус</th>
        </tr>
        </thead>
        <tbody>
        {{range .Page.Items}}
        <tr>
            <td><a href="/admin/reports/{{.ID}}">#{{.ID}}</a></td>
            <td class="nowrap">{{dt .CreatedAt}}</td>
            <td class="nowrap">{{badge "report_target" .TargetType}} <span class="muted">#{{.TargetID}}</span></td>
            <td>{{.ReasonTitle}}</td>
            <td><a href="/admin/users/{{.TargetOwnerID}}">{{.TargetOwnerID}}</a></td>
            <td><a href="/admin/users/{{.ReporterID}}">{{.ReporterID}}</a></td>
            <td>{{badge "report_status" .Status}}</td>
        </tr>
        {{end}}
        </tbody>
    </table>
    <div class="pager">
        <span>Всего: {{.Page.Total}} · страница {{.Page.CurrentPage}} из {{.Page.Pages}}</span>
        <span class="links">
            {{if .Page.HasPrev}}<a class="btn btn-secondary btn-sm" href="{{.LinkWithOffset .Page.PrevOffset}}">← Назад</a>{{end}}
            {{if .Page.HasNext}}<a class="btn btn-secondary btn-sm" href="{{.LinkWithOffset .Page.NextOffset}}">Вперёд →</a>{{end}}
        </span>
    </div>
    {{else}}
    <div class="empty">Жалоб нет</div>
    {{end}}
</div>
{{end}}
{{end}}
