{{define "tags"}}{{template "layout" .}}{{end}}
{{define "content"}}
<div class="page-header">
    <div>
        <h1>Теги</h1>
        <p class="subtitle">Скрытый тег пропадает из каталога и из выбора в приложении, но остаётся на митапах и в профилях, где уже стоит. Скрытие обратимо; удаления нет намеренно.</p>
    </div>
</div>

<form method="post" action="/admin/tags" class="card inline-form">
    <input type="text" name="name" placeholder="Новый тег" required minlength="2" maxlength="40" aria-label="Название нового тега">
    <button type="submit">Добавить</button>
</form>

<div class="card card-flush">
    <table class="table">
        <thead>
        <tr><th class="num">ID</th><th>Название</th><th class="num">Митапов</th><th class="num">Профилей</th><th></th></tr>
        </thead>
        <tbody>
        {{range .Data.Tags}}
        <tr{{if .IsHidden}} class="row-muted"{{end}}>
            <td class="num">{{.ID}}</td>
            <td>
                <details class="rename">
                    <summary>
                        <span>{{.Name}}</span>
                        {{if .IsHidden}}{{mark "neutral" "скрыт"}}{{end}}
                        <span class="btn btn-ghost btn-sm">Переименовать</span>
                    </summary>
                    <form method="post" action="/admin/tags/{{.ID}}/rename" class="inline-form">
                        <input type="text" name="name" value="{{.Name}}" required minlength="2" maxlength="40" aria-label="Новое название">
                        <button type="submit" class="btn-sm">Сохранить</button>
                    </form>
                </details>
            </td>
            <td class="num">{{.Meetups}}</td>
            <td class="num">{{.Users}}</td>
            <td class="num">
                {{if .IsHidden}}
                <form method="post" action="/admin/tags/{{.ID}}/unhide" class="inline">
                    <button type="submit" class="btn-secondary btn-sm">Показать</button>
                </form>
                {{else}}
                <form method="post" action="/admin/tags/{{.ID}}/hide" class="inline"
                      onsubmit="return confirm('Скрыть тег? Он пропадёт из выбора в приложении, но останется на митапах и в профилях.')">
                    <button type="submit" class="btn-ghost-danger btn-sm">Скрыть</button>
                </form>
                {{end}}
            </td>
        </tr>
        {{else}}
        <tr><td colspan="5" class="empty">Тегов нет</td></tr>
        {{end}}
        </tbody>
    </table>
</div>
{{end}}
