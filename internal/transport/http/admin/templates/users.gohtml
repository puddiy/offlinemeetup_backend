{{define "users"}}{{template "layout" .}}{{end}}
{{define "content"}}
<div class="page-header">
    <h1>Пользователи</h1>
</div>

<form method="get" action="/admin/users" class="card filters">
    <label class="field grow">
        <span>Поиск</span>
        <input type="text" name="q" value="{{.Data.Search}}" placeholder="email, username или id" autofocus>
    </label>
    <label class="field">
        <span>Статус</span>
        <select name="status">
            <option value="">любой</option>
            <option value="active"{{if eq .Data.Status "active"}} selected{{end}}>активен</option>
            <option value="inactive"{{if eq .Data.Status "inactive"}} selected{{end}}>неактивен</option>
            <option value="banned"{{if eq .Data.Status "banned"}} selected{{end}}>заблокирован</option>
        </select>
    </label>
    <label class="check">
        <input type="checkbox" name="deleted" value="1"{{if .Data.OnlyDeleted}} checked{{end}}>
        только удалённые
    </label>
    <button type="submit">Искать</button>
</form>

<div class="card card-flush">
    {{template "users_table" .Data}}
</div>
{{end}}
