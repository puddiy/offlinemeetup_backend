{{define "address_fields"}}
<label>
    <span>Адрес</span>
    <input type="text" name="address" value="{{.Address}}" maxlength="500">
</label>
<div style="display:flex;gap:10px">
    <label style="flex:1"><span>Широта</span><input type="text" name="lat" value="{{.Lat}}" inputmode="decimal"></label>
    <label style="flex:1"><span>Долгота</span><input type="text" name="lng" value="{{.Lng}}" inputmode="decimal"></label>
</div>
{{end}}
